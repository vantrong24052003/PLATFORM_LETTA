						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Support Bot\",\n  \"greeting\": \"Hi there! How may I assist you?\",\n  \"system\": \"You are an expert customer support agent.\",\n  \"knowledge_base_ids\": [\"kb-uuid-456\"]\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/bots/{{BOT_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "bots", "{{BOT_ID}}"]
						},
						"description": "Update bot configuration (name, greeting, system, knowledge_base_ids)"
					},
					"response": []
				},
				{
					"name": "Delete Bot",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/letta/bots/{{BOT_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "bots", "{{BOT_ID}}"]
						},
						"description": "Delete a chatbot template"
					},
					"response": []
				},
				{
					"name": "Get or Create Agent for Bot (User-specific)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"user-456\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/bots/{{BOT_ID}}/agents",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "bots", "{{BOT_ID}}", "agents"]
						},
						"description": "Get existing agent or create new agent for a specific user interacting with this bot"
					},
					"response": []
				},
				{
					"name": "Get Agent Mapping by User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/letta/bots/{{BOT_ID}}/agents?userId=user-456",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "bots", "{{BOT_ID}}", "agents"],
							"query": [
								{
									"key": "userId",
									"value": "user-456"
								}
							]
						},
						"description": "Get the agent ID for a specific user and bot"
					},
					"response": []
				}
			]
