		{
			"name": "5. Messages (Chat)",
			"item": [
				{
					"name": "Send Message to Agent",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"message\": \"Hello! Can you help me find a product?\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/messages/{{AGENT_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "messages", "{{AGENT_ID}}"]
						},
						"description": "Send a message to agent. Used by widget to chat."
					},
					"response": []
				},
				{
					"name": "Send Message with Tool Approval",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"approve\": true\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/messages/{{AGENT_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "messages", "{{AGENT_ID}}"]
						},
						"description": "Approve a pending tool call (auto-handled in widget)"
					},
					"response": []
				},
				{
					"name": "List Messages",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/letta/messages?agentId={{AGENT_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "messages"],
							"query": [
								{
									"key": "agentId",
									"value": "{{AGENT_ID}}"
								}
							]
						},
						"description": "Get message history for an agent"
					},
					"response": []
