				{
					"name": "Create Tool - Search Product",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"search_product\",\n  \"description\": \"Search products in database by name or category\",\n  \"sourceCode\": \"def search_product(query: str, category: str = None):\\n    \\\"\\\"\\\"\\n    Search for products in the database.\\n    \\n    Args:\\n        query (str): Search query\\n        category (str): Optional category filter\\n    \\\"\\\"\\\"\\n    pass\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/tools",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "tools"]
						},
						"description": "Register a new tool. User can create custom tools on UI."
					},
					"response": []
				},
				{
					"name": "Create Tool - Post Finder",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"post_finder\",\n  \"description\": \"Find posts by author name, keyword, or status.\",\n  \"sourceCode\": \"def post_finder(author_name: str = None, keyword: str = None, limit: int = 10, status: str = None):\\n    \\\"\\\"\\\"\\n    Find posts by author name, keyword, or status. Returns a list of posts with title, status, and author.\\n    \\n    Args:\\n        author_name (str): Name of the author to filter by\\n        keyword (str): Keyword to search in post title\\n        status (str): Status of the post (e.g. published, draft)\\n        limit (int): Max number of results to return\\n    \\\"\\\"\\\"\\n    pass\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/tools",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "tools"]
						}
					},
					"response": []
				},
				{
					"name": "Create Tool - Calculator",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"calculator\",\n  \"description\": \"Perform basic arithmetic calculations.\",\n  \"sourceCode\": \"def calculator(expression: str):\\n    \\\"\\\"\\\"\\n    Perform basic arithmetic calculations.\\n    \\n    Args:\\n        expression (str): Mathematical expression (e.g. 50 * 10)\\n    \\\"\\\"\\\"\\n    pass\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/tools",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "tools"]
						}
					},
					"response": []
				},
