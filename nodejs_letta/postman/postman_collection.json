		{
			"name": "2. Knowledge Bases",
			"item": [
				{
					"name": "Create Knowledge Base",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Product Documentation\",\n  \"description\": \"Complete product information and FAQs\",\n  \"content\": \"Q: What are your working hours?\\nA: We work from 9 AM to 6 PM, Monday to Friday.\\n\\nQ: Where is your office?\\nA: 123 Nguyen Hue St, District 1, Ho Chi Minh City.\",\n  \"organization_id\": \"org-123\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/knowledge-bases",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "knowledge-bases"]
						},
						"description": "Create a new knowledge base. Status will be 'processing' initially, then 'success' when indexed."
					},
					"response": []
				},
				{
					"name": "List Knowledge Bases",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/letta/knowledge-bases?organization_id=org-123",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "knowledge-bases"],
							"query": [
								{
									"key": "organization_id",
									"value": "org-123",
									"description": "Filter by organization (multi-tenant support)"
								}
							]
						},
						"description": "Get all knowledge bases for an organization"
					},
					"response": []
				},
				{
					"name": "Get Knowledge Base by ID",
					"request": {
						"method": "GET",
						"header": [],
