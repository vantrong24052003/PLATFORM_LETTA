							"raw": "{{BASE_URL}}/api/letta/knowledge-bases/{{KB_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "knowledge-bases", "{{KB_ID}}"]
						},
						"description": "Get a specific knowledge base by ID"
					},
					"response": []
				},
				{
					"name": "Update Knowledge Base",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Product Docs\",\n  \"description\": \"Updated FAQs\",\n  \"content\": \"New content here...\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/knowledge-bases/{{KB_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "knowledge-bases", "{{KB_ID}}"]
						},
						"description": "Update knowledge base. If content is updated, status becomes 'processing' again."
					},
					"response": []
				},
				{
					"name": "Delete Knowledge Base",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/letta/knowledge-bases/{{KB_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "knowledge-bases", "{{KB_ID}}"]
						},
						"description": "Delete a knowledge base and its associated Letta source"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Tools",
