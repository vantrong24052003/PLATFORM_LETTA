	"item": [
		{
			"name": "1. Bots (Chatbot Templates)",
			"item": [
				{
					"name": "Create Bot",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"bot-uuid-123\",\n  \"name\": \"Customer Support Bot\",\n  \"greeting\": \"Hello! How can I help you today?\",\n  \"system\": \"You are a helpful customer support assistant. Be polite and professional.\",\n  \"organization_id\": \"org-123\",\n  \"llm_config\": {\n    \"model\": \"gpt-4\",\n    \"temperature\": 0.7\n  },\n  \"knowledge_base_ids\": [],\n  \"theme_config\": {\n    \"primaryColor\": \"#007bff\",\n    \"position\": \"bottom-right\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/letta/bots",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "letta", "bots"]
						},
						"description": "Create a new chatbot template with configuration"
					},
					"response": []
				},
				{
					"name": "List Bots",
