							"raw": "{{base_url}}/letta/bot_templates/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"letta",
								"bot_templates",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "template-uuid-here"
								}
							]
						},
						"description": "Get a specific bot template by ID"
					},
					"response": []
				},
				{
					"name": "Update Bot Template",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bot_template\": {\n    \"name\": \"Updated Sales Assistant\",\n    \"system_prompt\": \"You are an expert sales assistant\",\n    \"greeting\": \"Welcome! How can I assist you today?\",\n    \"theme_config\": {\n      \"primary_color\": \"#FF6B35\"\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/letta/bot_templates/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"letta",
								"bot_templates",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "template-uuid-here"
								}
							]
						},
						"description": "Update an existing bot template (cannot update id or organization_id)"
					},
					"response": []
				},
				{
					"name": "Delete Bot Template",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/letta/bot_templates/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"letta",
								"bot_templates",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "template-uuid-here"
								}
							]
						},
						"description": "Delete a bot template"
					},
					"response": []
