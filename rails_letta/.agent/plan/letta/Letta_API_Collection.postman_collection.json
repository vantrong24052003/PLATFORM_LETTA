		},
		{
			"name": "Phase 2: Streaming Messages",
			"item": [
				{
					"name": "Stream Message",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "text/event-stream"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"agent_id\": \"agent-c3e0a08f-cb96-46ba-bdd2-e5e66ba48de3\",\n  \"input\": \"Tell me a short story about AI\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/letta/streaming_messages",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"letta",
								"streaming_messages"
							]
						},
						"description": "Stream AI responses using SSE.\n\nEvents:\n- `content`: Token chunks\n- `done`: Usage info\n- `error`: Error details"
					},
					"response": []
				}
			],
			"description": "Real-time streaming message endpoints (SSE)"
		}
