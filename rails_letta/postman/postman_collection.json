{
	"info": {
		"_postman_id": "letta-rails-api",
		"name": "Letta Rails API",
		"description": "API collection for Letta integration in Rails",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "agent",
			"item": [
				{
					"name": "create",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test Agent\",\n  \"system\": \"You are a helpful AI assistant. Be polite and professional.\",\n  \"tools\": [],\n  \"memory_blocks\": [],\n  \"include_base_tool_rules\": true\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/letta/agents",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"letta",
								"agents"
							]
						},
						"description": "Create a new agent in Letta"
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "BASE_URL",
			"value": "http://localhost:4000",
			"type": "string"
		}
	]
}
